# ID Pemilik Bot (Owner IDs dipisahkan dengan koma)
OWNER_IDS=925562642989457500

# Kunci Enkripsi Fernet (32-byte URL-safe base64) untuk mengamankan password akun di database
SECRET_KEY=3vTYPpQgPk0np8fRj8tLuhcLdEDx1rFE3fWYyIyN2bc=

# Worker Lucifer v2.86 API URL & Secret Token
# Jika bot Discord dan Lucifer berjalan di VPS/komputer yang sama, gunakan http://127.0.0.1:8081
